{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile information, roles, and premium status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "fullName": { "type": "string" },
        "dob": { "type": "string" },
        "photoURL": { "type": "string" },
        "username": { "type": "string", "description": "Unique user handle for chatting and class identification" },
        "role": { "type": "string", "enum": ["admin", "student"] },
        "matric": { "type": "string" },
        "matricNumber": { "type": "string" },
        "university": { "type": "string" },
        "level": { "type": "string" },
        "department": { "type": "string" },
        "faculty": { "type": "string" },
        "about": { "type": "string", "description": "User bio/about info" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "deleted", "online", "offline"] },
        "premiumUntil": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Note": {
      "title": "Lecture Note",
      "description": "Captured notes and transcriptions from lectures.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "content"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "Public educational articles.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "authorId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "excerpt": { "type": "string" },
        "category": { "type": "string" },
        "likes": { "type": "integer" }
      },
      "required": ["title", "content", "timestamp"]
    },
    "Notification": {
      "title": "System Notification",
      "description": "Alerts for users.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      },
      "required": ["title", "message", "timestamp"]
    },
    "Exam": {
      "title": "Academic Exam",
      "description": "Hosted exam infrastructure.",
      "type": "object",
      "properties": {
        "hostUid": { "type": "string" },
        "title": { "type": "string" },
        "duration": { "type": "integer" },
        "questions": { "type": "array" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hostUid", "title", "questions"]
    },
    "ExamResult": {
      "title": "Exam Result",
      "description": "Recorded score of a student's exam.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "matric": { "type": "string" },
        "score": { "type": "integer" },
        "total": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "hostUid": { "type": "string" }
      },
      "required": ["uid", "score", "total", "timestamp"]
    },
    "ChatSession": {
       "title": "Chat Session",
       "description": "User specific AI conversation history.",
       "type": "object",
       "properties": {
         "id": { "type": "string" },
         "title": { "type": "string" },
         "history": { "type": "array" },
         "timestamp": { "type": "string" },
         "isPinned": { "type": "boolean" }
       }
    },
    "LectureSession": {
      "title": "Lecture Recording Session",
      "description": "AI transcribed and analyzed lecture data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "content": { "type": "string" },
        "summary": { "type": "string" },
        "quiz": { "type": "array" },
        "timestamp": { "type": "string" }
      }
    },
    "HistoryItem": {
      "title": "Study History Item",
      "description": "Record of user activity (quiz, analysis, etc).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "score": { "type": "integer" },
        "total": { "type": "integer" },
        "date": { "type": "string" },
        "data": { "type": "object" }
      }
    },
    "Report": {
      "title": "Safety Report",
      "description": "User reported content or users.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "suspectId": { "type": "string" },
        "reporterEmail": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "Chat": {
      "title": "Chat Channel",
      "description": "Direct or group chat channel.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "members": { "type": "array" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isOmni": { "type": "boolean" },
        "ownerId": { "type": "string" },
        "unreadBy": { "type": "array" }
      }
    },
    "Message": {
      "title": "Chat Message",
      "description": "Individual message in a chat.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderHandle": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "object" },
        "seenBy": { "type": "array" },
        "deletedBy": { "type": "array" },
        "deletedForEveryone": { "type": "boolean" },
        "status": { "type": "string" }
      }
    },
    "Class": {
      "title": "Live Class",
      "description": "Interactive class session.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "hostId": { "type": "string" },
        "boardData": { "type": "array" },
        "participants": { "type": "array" },
        "isActive": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles and settings."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Safety reports filed by users."
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "User generated study notes."
    },
    "/blogPosts/{postId}": {
      "schema": "BlogPost",
      "description": "Public educational articles."
    },
    "/notifications/{notifId}": {
      "schema": "Notification",
      "description": "System-wide and targeted notifications."
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Scheduled exam documentation."
    },
    "/exams/{examId}/results/{resultId}": {
      "schema": "ExamResult",
      "description": "Student exam results."
    },
    "/users/{uid}/lectureSessions/{sessionId}": {
      "schema": "LectureSession",
      "description": "User's lecture recording history."
    },
    "/users/{uid}/chatSessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "User's AI chat history."
    },
    "/users/{uid}/studyHistory/{historyId}": {
      "schema": "HistoryItem",
      "description": "User's overall activity ledger."
    },
    "/email_templates/{templateId}": {
      "schema": "object",
      "description": "Internal marketing templates."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat sessions between users or groups."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages within a chat."
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "Live class sessions with board and participants."
    }
  }
}
