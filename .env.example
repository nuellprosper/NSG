# Gemini API Key (Required)
# You can set this as GEMINI_API_KEY or VITE_GEMINI_API_KEY in Render
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_HUGGINGFACE_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET= # Must be an 'Unsigned' preset in Cloudinary settings
VITE_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=
VITE_TOGETHER_API_KEY=
TOGETHER_API_KEY=

# Firebase Configuration Overrides
VITE_FIREBASE_AUTH_DOMAIN= # e.g. auth.yourcustomdomain.com

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=

# Email Configuration (Gmail)
EMAIL_USER=nuellstudyguide@gmail.com
EMAIL_PASS= # Generate at https://myaccount.google.com/apppasswords
ADMIN_SECRET=GOD_MODE

# OMNI API Gateway Credentials
OMNI_BRIDGE_SECRET=

# Custom Free WhatsApp Bot API Configuration
WHATSAPP_BOT_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Resend API Configuration (Server-side relay for OTPs & Admin emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=NSG Academic Portal <onboarding@resend.dev>

# Application Security Secret (Protects serverless endpoints from unauthorized calls)
NSG_APP_SECRET=
VITE_NSG_APP_SECRET=

